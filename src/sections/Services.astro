---
import { Image } from 'astro:assets';

import ArrowService from '../assets/svgs/ArrowService.svg';

const services = [
    {
        title: 'Landings que convierten',
        description: 'Diseñadas para transformar visitas en consultas reales.',
        price: '150 USD',
        url: 'https://www.mastercred.com',
        tagLeftDates: 
        [
            'Hosting y dominio',
            'Arquitectura de la página',
            'UX/UI único',
            'Diseño responsive'
        ],
        tagRightDates: [
            'SEO optimizado',
            'Velocidad de carga <1s',
            'Formularios e Integraciones',
            'Analítica de visitas'
        ],
        imageExample: '/src/assets/images/projects/MockupMasterCred.png',
        z: 'z-10',
        bg: 'bg-gray-100',
        darkBg: 'dark:bg-neutral-950',
    },
    {
        title: 'E-Commerces que venden',
        description: 'Diseñadas para transformar visitas en consultas reales.',
        price: '250 USD',
        tagLeftDates: [
            'Gestión de stock',
            'Carrito de compras',
            'Filtros y búsqueda',
            'Integraciones de pagos',
        ],
        tagRightDates: [
            'Escalable y optimizado',
            'Posicionamiento en Google #1',
            'Metricas y analítica de ventas',
            'Seguridad y privacidad de datos',

        ],
        z: 'z-20',
        bg: 'bg-white',
        url: 'https://www.mastercred.com',
        imageExample: '/src/assets/images/LogoMastercred.webp',
    },
    {
        title: 'Automatización de procesos',
        description: 'Automatización de procesos para optimizar tu negocio.',
        price: '350 USD',
        tagLeftDates: [
            'Automatización de procesos',
            'Automatización de procesos',
            'Automatización de procesos',
        ],
        tagRightDates: [
            'Automatización de procesos',
            'Automatización de procesos',
        ],
        imageExample: '/src/assets/images/projects/MockupMasterCred.png',
        z: 'z-30',
        bg: 'bg-gray-100',
        darkBg: 'dark:bg-neutral-900',
    }
]
---
<section id="services" class="relative">
    {services.map((service) => (
        <article data-service class={`min-h-screen overflow-hidden px-3 sticky top-0 ${service.z} ${service.bg} ${service.darkBg}`}>
            <div class="grid grid-cols-2 gap-y-10 py-20 md:grid-cols-3">

                {/* Enfoque y etiquetas  */}
                <div class="flex flex-col gap-3 order-2 md:order-1 md:justify-center ">
                    <p class="text-blue-500 font-anton uppercase md:text-xl">
                        ( Incluye )
                    </p>
                    <ul class="font-grotesk font-medium text-sm flex flex-col gap-y-2 md:text-lg">
                        {service.tagLeftDates?.map((tag) => (
                            <li class="border-b border-neutral-200 dark:border-neutral-800 w-fit md:pb-2">
                                {tag}
                            </li>
                        ))}
                    </ul>
                </div>

                {/* Informacion del servicio */}
            
                <div class="flex flex-col justify-center items-center gap-2 order-1 col-span-2 md:col-span-1">

                
                    <h2 data-service-title class="font-anton text-5xl text-balance tracking-tight uppercase w-xs text-center md:w-auto md:text-8xl">
                        {service.title}
                    </h2>

                    <p data-service-description class="font-grotesk font-normal text-center text-sm mt-3 mb-4 md:text-xl">
                        {service.description}
                    </p>
                    
                    
                    <a href={service.url} aria-label="Ver proyecto" target="_blank" class="relative block -rotate-3 group transition-all duration-500 md:hover:rotate-0">
                        <Image data-service-image src={service.imageExample}  alt="Imagen de proyecto realizado" width={100} height={100} class="size-full max-w-xl object-cover" />

                        {/* Texto de Explorar en PC */}
                        <div class=" hidden absolute inset-0 items-center justify-center opacity-0 transition-all duration-300 group-hover:opacity-100 md:flex">
                            <span class="relative flex items-center gap-2 rounded-lg border border-white/20 bg-black px-5 py-3 font-anton text-2xl uppercase text-white shadow-xl shadow-black/30 transition-all duration-300 ">
                                <ArrowService class="size-8 rotate-45" />
                                <span>Explorar proyecto</span>
                            </span>
                        </div>

                        {/* Texto de Explorar en Mobile */}
                        <div data-service-explore-mobile class="absolute inset-0 left-15 bottom-10 items-end font-anton uppercase md:hidden flex">
                            <span class="flex items-center bg-black text-white px-2 py-1 ml-2 mb-2 shadow-lg shadow-black/30">
                                <ArrowService class="size-5 text-white"/>
                                <span>Explorar</span>
                            </span>
                        </div>
                    </a>
                    <p data-service-price class="mt-5 font-grotesk font-light text-md tracking-wide">
                        Proyectos desde: 
                        <span class="text-emerald-600 font-bold">{service.price}</span> 
                        <span class="text-neutral-500 text-xs dark:text-neutral-300">· Según alcance</span>
                    </p>

                </div>

                {/* Nuestro enfoque y etiquetas */}
                <div class="justify-items-end order-3 mt-6 md:justify-center flex flex-col"> 
                    <p class="text-blue-500 font-anton md:text-xl uppercase mb-3 text-right">
                        ( Enfoque )
                    </p>
                    <ul class="font-grotesk font-medium text-sm md:text-lg gap-y-2 flex flex-col items-end">
                        {service.tagRightDates?.map((tag) => (
                            <li class="border-b border-neutral-200 dark:border-neutral-800 w-fit md:pb-2">
                                {tag}
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </article>
    ))}
</section>
<script src="../scripts/Services.js"></script>