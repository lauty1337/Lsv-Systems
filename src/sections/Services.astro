---
import { Image } from 'astro:assets';

const services = [
    {
        title: 'Landings que convierten',
        tagLeftDates: 
        [
            'Hosting y dominio',
            'Arquitectura de la pagina',
            'UX/UI unicos',
            'Design Responsive'
        ],
        tagRightDates: [
            'SEO optimizado',
            'Velocidad de carga <1s',
            'Formularios e Integraciones',
            'Analitica de visitas'
        ],
        imageExample: '/src/assets/images/LogoMastercred.webp',
        z: 'z-10',
        bg: 'bg-gray-200',
        darkBg: 'dark:bg-neutral-900',
    },
    {
        title: 'E-Commerces que venden',
        imageExample: '/src/assets/images/LogoMastercred.webp',
        z: 'z-20',
        bg: 'bg-gray-300'
    }
]
---
<section id="services" class="relative">
    {services.map((service) => (
        <article class={`min-h-screen sticky top-0 ${service.z} ${service.bg} ${service.darkBg}`}>
            <div class="grid grid-cols-3 items-center">

                {/* Enfoque y etiquetas  */}
                <div class="flex flex-col gap-2">
                    <p>
                        ( Enfoque )
                    </p>
                    <ul>
                        {service.tagLeftDates?.map((tag) => (
                            <li>
                                {tag}
                            </li>
                        ))}
                    </ul>
                </div>

                {/* Titulo y imagen de de proyecto realizado */}
                <div class="flex flex-col justify-center items-center gap-2">
                    <h2>{service.title}</h2>
                    <a>
                        <Image src={service.imageExample} alt="Imagen de proyecto realizado" width={100} height={100} />
                    </a>
                </div>

                {/* Nuestro enfoque y etiquetas */}
                <div class="justify-items-end"> 
                    <p>
                        ( Nuestro enfoque )
                    </p>
                    <ul>
                        {service.tagRightDates?.map((tag) => (
                            <li class="">
                                {tag}
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </article>
    ))}
</section>