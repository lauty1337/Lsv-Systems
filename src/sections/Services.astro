---
import { Image } from 'astro:assets';

import ArrowService from '../assets/svgs/ArrowService.svg';

const services = [
    {
        title: 'Landings que convierten',
        description: 'Diseñadas para transformar visitas en consultas reales.',
        price: '150 USD',
        tagLeftDates: 
        [
            'Hosting y dominio',
            'Arquitectura de la página',
            'UX/UI único',
            'Diseño responsive'
        ],
        tagRightDates: [
            'SEO optimizado',
            'Velocidad de carga <1s',
            'Formularios e Integraciones',
            'Analítica de visitas'
        ],
        imageExample: '/src/assets/images/projects/MockupMasterCred.png',
        z: 'z-10',
        bg: 'bg-gray-100',
        darkBg: 'dark:bg-neutral-900',
        url: 'https://www.mastercred.com',
    },
    {
        title: 'E-Commerces que venden',
        description: 'Diseñadas para transformar visitas en consultas reales.',
        price: '250 USD',
        tagLeftDates: [
            'Catálogo de productos',
            'Carrito de compras',
            'Filtros y búsqueda',
            'Diseño de tienda',
        ],
        tagRightDates: [
            'Escalable y optimizado',
            ''

        ],
        z: 'z-20',
        bg: 'bg-gray-200',
        url: 'https://www.mastercred.com',
        imageExample: '/src/assets/images/LogoMastercred.webp',
    }
]
---
<section id="services" class="relative">
    {services.map((service) => (
        <article data-service class={`min-h-screen overflow-hidden px-3 sticky top-0 ${service.z} ${service.bg} ${service.darkBg}`}>
            <div class="grid grid-cols-2 gap-y-10 py-20  md:grid-cols-3">

                {/* Enfoque y etiquetas  */}
                <div class="flex flex-col gap-3 order-2 md:order-1 md:justify-center ">
                    <p class="text-blue-500 font-anton md:text-xl uppercase">
                        ( Incluye )
                    </p>
                    <ul class="font-grotesk font-medium text-sm flex flex-col gap-y-2 md:text-lg">
                        {service.tagLeftDates?.map((tag) => (
                            <li>
                                {tag}
                            </li>
                        ))}
                    </ul>
                </div>

                {/* Informacion del servicio */}
            
                <div class="flex flex-col justify-center items-center gap-2 order-1 col-span-2 md:col-span-1">

                    <h2 data-service-title class="font-anton text-6xl md:text-8xl text-balance uppercase w-xs md:w-auto text-center">
                        {service.title}
                    </h2>

                    <p data-service-description class="font-grotesk font-medium text-center text-sm md:text-xl mt-3 mb-4">
                        {service.description}
                    </p>
                    

                    <a href={service.url} aria-label="Ver proyecto" target="_blank" class="relative overflow-hidden -rotate-3  md:hover:rotate-1 md:hover:scale-105 bg-blue-500 group px-1 py-3 rounded-lg shadow-lg md:shadow-xl shadow-blue-500/50 transition-all duration-500">
                        <Image data-service-image src={service.imageExample}  alt="Imagen de proyecto realizado" width={100} height={100} class="size-full max-w-xl object-cover" />

                        {/* Texto de Explorar en PC */}
                        <div class="hidden md:flex absolute inset-0 items-start justify-center font-anton uppercase group -translate-y-35 group-hover:translate-y-0 transition-all duration-200 text-9xl text-black">
                            <span class="flex items-center ">
                                <ArrowService class="size-12 md:size-20" />
                                <span>Explorar</span>
                            </span>
                        </div>

                        {/* Texto de Explorar en Mobile */}
                        <div class="flex md:hidden absolute inset-0 items-end  font-anton uppercase ">
                            <span class="flex items-center bg-black text-white px-2 py-1 ml-2 mb-2 shadow-lg shadow-black/30">
                                <ArrowService class="size-5 text-white  " />
                                <span>Explorar</span>
                            </span>
                        </div>
                    </a>
                    <p data-service-price class="mt-5 font-grotesk text-left font-light text-md tracking-wide">
                        Proyectos desde: 
                        <span class="text-emerald-600 font-bold">{service.price}</span> 
                        <span class="text-neutral-500 text-xs">· Según alcance</span>
                    </p>
                </div>

                {/* Nuestro enfoque y etiquetas */}
                <div class="justify-items-end order-3 mt-6 md:justify-center flex flex-col"> 
                    <p class="text-blue-500 font-anton md:text-xl uppercase mb-3 text-right">
                        ( Enfoque )
                    </p>
                    <ul class="font-grotesk font-medium text-sm md:text-lg gap-y-2 flex flex-col text-right">
                        {service.tagRightDates?.map((tag) => (
                            <li>
                                {tag}
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </article>
    ))}
</section>
<script src="../scripts/Services.js"></script>