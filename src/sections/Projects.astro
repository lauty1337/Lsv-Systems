---
import { projects } from '../data/projects.ts'
---







<section id="projects" class="bg-white min-h-screen py-10">
    <div class="px-3 mb-30">
        <div class="flex justify-between items-center text-lg md:text-3xl">
            <span class="font-anton uppercase translate-y-6 md:translate-y-8">Ultimos</span>
            <span class="hidden md:block translate-y-4 font-grotesk font-light text-lg">Landings pages</span>
            <span class="font-anton uppercase"> Proyectos </span>
            <span class="hidden md:block translate-y-4 font-grotesk font-light text-lg">E-Commerces</span>
            <span class="font-anton uppercase translate-y-6 md:translate-y-8">2026©</span>
        </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 ">
        {projects.map((project)  => ( 
            <article class="p-1 bg-neutral-100 flex flex-col">
            </article>
        ))}
    </div>
</section>