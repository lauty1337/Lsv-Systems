---
const steps = [
    {
        numberStep: 1,
        title: 'Recepción de la solicitud',
        description: 'Recibimos tu solicitud y te contactamos para coordinar el proyecto.',
    },
    {
        numberStep: 2,
        title: 'Análisis del proyecto',
        description: 'Analizamos tu proyecto y te proporcionamos un presupuesto.',
    },
    {
        numberStep: 3,
        title: 'Inicio del proyecto',
        description: 'Iniciamos el proyecto y te proporcionamos un presupuesto.',
    },
    {
        numberStep: 4,
        title: 'Finalización del proyecto',
        description: 'Finalizamos el proyecto y te proporcionamos un presupuesto.',
    },
]
---



<section class="py-10">
    <h2 class="font-anton uppercase text-4xl text-center px-3 py-10">
        Proceso de trabajo
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 px-3 relative">

        <div aria-hidden="true" class="absolute left-1/2 top-5 bottom-5 w-0.5 opacity-50 bg-neutral-400 ">
            <div data-progress-bar-fill></div>
        </div>

        <ol class="flex flex-col gap-10 items-center justify-center">
        {steps.map((step) => (
            <li class="flex flex-col gap-2 opacity-70 items-center justify-center z-10" data-step>
                <span class="font-grotesk text-xl p-2 px-4 rounded-full bg-black w-fit text-white mb-5">{step.numberStep}</span>
                <h3 class="font-grotesk text-lg px-2 bg-white mb-5">{step.title}</h3>
                <p class="font-grotesk text-sm text-center px-2 bg-white ">{step.description}</p>
            </li>
        ))}
        </ol>
    </div>
    
</section>
<script> 
        import '../scripts/Process.js';
</script>