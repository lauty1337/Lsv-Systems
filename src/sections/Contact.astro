---
import Commerce from '../assets/svgs/Commerce.svg';
import Company from '../assets/svgs/Company.svg';
import Flag from '../assets/svgs/Flag.svg';
import ArrowRight from '../assets/svgs/ArrowRight.svg';
import WhatsApp from '../assets/svgs/WhatsApp.svg';
import  PulseDot  from '../components/PulseDot.astro';
---


<section id="contact" class="py-20 px-3 md:scroll-mb-180">
    <div class="mb-30 px-3">
        <div class="flex justify-between items-center text-lg md:text-3xl">
            <div class="flex-1 flex justify-between items-center">
                <span class="font-anton uppercase translate-y-6 md:translate-y-15">2026©</span>
                <span class="hidden md:block translate-y-4 font-light text-lg">Email</span>
            </div>
            <h2 class="font-anton uppercase mx-auto md:mx-40 px-4"> Contacto </h2>
            
            <div class="flex-1 flex justify-end md:justify-between items-center">
                <span class="hidden md:block translate-y-4 font-light text-lg">WhatsApp</span>
                <span class="font-anton uppercase translate-y-6 md:translate-y-15">LSV ©</span>
            </div>
        </div>
    </div>

    <div class="flex justify-center max-w-425 mx-auto gap-y-15 md:gap-5">
        
        <form action="" method="POST" class="flex flex-col border border-neutral-200 dark:border-neutral-800 p-5 row-span-2">

            <small class="text-gray-600 dark:text-gray-400 uppercase mb-2">01 — Formulario</small>
            <h3 class="font-anton uppercase text-3xl md:text-4xl ">Especificaciones  iniciales</h3>
            <div class="flex flex-col  mt-10 gap-5  ">
                <div class="flex flex-col">
                    <label class="font-medium uppercase mb-2 ">Tu nombre o empresa *</label>
                    <input type="text" required aria-required="true" minlength="3" maxlength="30" name="name" placeholder="Ej. Juan Pérez o Studio Pérez" class="border focus:ring-blue-600 focus:ring-1 focus:outline-none border-neutral-200 dark:border-neutral-800 bg-gray-100 dark:bg-neutral-900 p-3 transition-colors" />
                </div>
                <div class="flex flex-col  ">
                    <label class=" flex mb-2 md:justify-between ">
                    <span class="font-medium  uppercase">WhatsApp o email   *</span>
                    <small class="text-xs text-balance text-gray-600 dark:text-gray-400 ">Respondemos por ahí</small>
                    </label>
                    <input type="text"  name="contact" placeholder="Ej. 2364***** o juanperez@gmail.com" minlength="10" maxlength="40" required aria-required="true"
                    class="border border-neutral-200 dark:border-neutral-800 focus:ring-blue-600 focus:ring-1 focus:outline-none bg-gray-100 dark:bg-neutral-900 p-3" />
                </div>
            </div>

            <fieldset class="flex flex-col gap-2 mt-10 md:grid md:grid-cols-2">
                <legend class="font-medium uppercase mb-2 ">Tipo de proyecto *</legend>

                <label class="bg-gray-100 dark:bg-neutral-900 flex items-center cursor-pointer gap-x-1 border-neutral-200 dark:border-neutral-800 border p-3 has-[input:checked]:bg-blue-600 has-[input:checked]:text-white hover:border-blue-600  transition-all duration-200 ">
                    <Flag class="size-5 text-black dark:text-white " />
                    <input type="radio" name="project-type" value="landing-page" class="appearance-none" /> 
                    <span class="font-medium">Landing page </span>
                </label>

                <label class="bg-gray-100 dark:bg-neutral-900 flex items-center cursor-pointer gap-x-1 border-neutral-200 dark:border-neutral-800 border p-3 has-[input:checked]:bg-blue-600 has-[input:checked]:text-white hover:border-blue-600  transition-all duration-200 ">
                    <Company class="size-5 text-black dark:text-white " />
                    <input type="radio" name="project-type" value="web-institucional"  class="appearance-none" />
                    <span class="font-medium"> Web Institucional</span>
                </label>

                <label class="bg-gray-100 dark:bg-neutral-900 flex items-center cursor-pointer gap-x-1 border-neutral-200 dark:border-neutral-800 border p-3 has-[input:checked]:bg-blue-600 has-[input:checked]:text-white hover:border-blue-600  transition-all duration-200 ">
                    <Commerce class="size-5 text-black dark:text-white " />
                    <input type="radio" name="project-type" value="ecommerce" class="appearance-none" />
                    <span class="font-medium">E-commerce <small>(WooCommerce)</small></span>
                </label>
            </fieldset>

            

            <label class="mt-10 font-medium uppercase mb-2 ">Contexto del proyecto <br> <small class="text-gray-600 dark:text-gray-400">(Opcional)</small> </label>
            <textarea name="context" maxlength="200" minlength="10" placeholder="Ej. Somos una agencia de marketing digital y queremos crear una landing page para nuestro nuevo producto" class="border focus:ring-blue-600 focus:ring-1 focus:outline-none border-neutral-200 dark:border-neutral-800 bg-gray-100 dark:bg-neutral-900 p-3 transition-colors resize-none h-25"></textarea>

            <button type="submit" class="mt-10 bg-black dark:bg-white text-white dark:text-black font-medium uppercase p-4 leading-4 text-balance hover:cursor-pointer hover:bg-neutral-700 dark:hover:bg-neutral-400 transition-all duration-300">
                Solicitar presupuesto & diagnóstico
            </button>
            <small class="text-gray-600 dark:text-gray-400 text-xs md:text-sm justify-center flex mt-5 mb-3"> O escríbime por WhatsApp</small>
            <div class="bg-gray-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 p-3  gap-3 flex flex-col md:flex-row
            md:justify-between">
                <div class="flex items-center gap-x-3">
                    <WhatsApp class="size-5 text-black dark:text-white " />
                    <div class="flex flex-col">
                        <p class="text-gray-600 dark:text-gray-400 text-xs md:text-sm">¿Preferis contactarme por WhatsApp? </p>
                        <p class="font-medium text-sm md:text-base">Escribime a través de este número </p>
                    </div>
                </div>
                <a href="https://wa.me/5491133333333" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-700 transition-colors duration-200 gap-x-3 flex items-center justify-center w-full md:w-auto px-4 py-2 bg-emerald-200 border-emerald-600 dark:bg-emerald-900 border dark:border-emerald-600 hover:bg-emerald-400 dark:hover:bg-emerald-800 group">
                    <span class="text-sm font-medium uppercase text-emerald-600">Escribir por WhatsApp</span>
                    <ArrowRight class="size-5 text-emerald-600 group-hover:translate-x-2 transition-transform duration-200 " />
                </a>
            </div>
        </form>
    </div>

</section>
    <script>
        import '../scripts/Contact.js'; 
    </script>