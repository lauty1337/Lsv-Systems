<section id="contact" class="py-20 px-3">
    <div class="mb-30 px-3">
        <div class="flex justify-between items-center text-lg md:text-3xl">
            <div class="flex-1 flex justify-between items-center">
                <span class="font-anton uppercase translate-y-6 md:translate-y-15">2026©</span>
                <span class="hidden md:block translate-y-4 font-grotesk font-light text-lg">Email</span>
            </div>
            <h2 class="font-anton uppercase mx-40 px-4"> Contacto </h2>
            <div class="flex-1 flex justify-end md:justify-between items-center">
                <span class="hidden md:block translate-y-4 font-grotesk font-light text-lg">WhatsApp</span>
                <span class="font-anton uppercase translate-y-6 md:translate-y-15">LSV ©</span>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2">
        
        <form action="" method="POST" class="flex flex-col border font-grotesk border-neutral-200 p-5">
            <small class="text-gray-600 font-grotesk uppercase mb-2">01 — Formulario</small>
            <h3 class="font-anton uppercase text-3xl pb-10 border-b border-neutral-200 leading-7.5">Especificaciones <br> iniciales</h3>
            
            <label class="font-medium uppercase mt-10 mb-2">Tu nombre o empresa *</label>
            <input type="text" name="name" placeholder="Ej. Juan Perez - Studio Perez" class="border focus:ring-blue-600 focus:ring-1 focus:outline-none border-neutral-200 bg-gray-100 p-3 transition-colors " />

            <fieldset class="flex flex-col gap-y-2 mt-10">
                <legend class="font-medium uppercase mb-2">Tipo de proyecto *</legend>

                <label>
                    <input type="radio" name="project-type" value="landing-page" /> 
                    <span>Landing page </span>
                </label>

                <label>
                    <input type="radio" name="project-type" value="web-institucional" />
                    <span> Web Institucional</span>
                </label>

                <label>
                    <input type="radio" name="project-type" value="ecommerce" />
                    <span>E-commerce <small>(WooCommerce)</small></span>
                </label>
            </fieldset>
            <label class="mt-10 flex mb-2 leading-4">
                <span class="font-medium  uppercase">Contacto directo <br>(WhatsApp o email) *</span>
                <small class="text-xs text-balance text-gray-600 ">Respondemos por ahi</small>
            </label>
            <input type="text" name="contact" placeholder="Ej. 2364***** o juanperez@gmail.com" class="border border-neutral-200 focus:ring-blue-600 focus:ring-1 focus:outline-none bg-gray-100 p-3" />

            <label class="mt-10 font-medium uppercase mb-2">Contexto del proyecto <br> <small class="text-gray-600">(Opcional)</small> </label>
            <textarea name="context" placeholder="Ej. Somos una agencia de marketing digital y queremos crear una landing page para nuestro nuevo producto" class="border focus:ring-blue-600 focus:ring-1 focus:outline-none border-neutral-200 bg-gray-100 p-3 transition-colors resize-none h-20"></textarea>

            <button type="submit" class="mt-10 bg-black text-white font-medium uppercase p-4 hover:cursor-pointer leading-4 text-balance hover:bg-neutral-700 transition-colors duration-300">
                Solicitar presupuesto & diagnostico
            </button>
        </form>
    </div>
</section>