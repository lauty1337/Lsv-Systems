---
import ArrowRight from '../assets/svgs/ArrowRight.svg';
import  PulseDot  from '../components/PulseDot.astro';

// Número de WhatsApp de la empresa: código de país + área + número, solo dígitos (ej. 5491123456789).
const WHATSAPP_NUMBER = '5490000000000';
---


<section id="contact" class="py-20 px-3 md:scroll-mb-180">
    <div class="mb-30 px-3">
        <div class="flex justify-between items-center text-lg md:text-3xl">
            <div class="flex-1 flex justify-between items-center">
                <span class="font-anton uppercase translate-y-6 md:translate-y-15">2026©</span>
                <span class="hidden md:block translate-y-4 font-light text-lg">Email</span>
            </div>
            <h2 class="font-anton uppercase mx-auto md:mx-40 px-4"> Contacto </h2>
            
            <div class="flex-1 flex justify-end md:justify-between items-center">
                <span class="hidden md:block translate-y-4 font-light text-lg">WhatsApp</span>
                <span class="font-anton uppercase translate-y-6 md:translate-y-15">LSV ©</span>
            </div>
        </div>
    </div>

    <form id="contact-form" data-whatsapp={WHATSAPP_NUMBER} class="border border-neutral-300 dark:border-neutral-800 rounded-md grid md:grid-cols-[2fr_1fr] md:max-w-300 md:mx-auto ">
        <div class="divide-y divide-neutral-300 dark:divide-neutral-800">
            <div class="flex justify-between items-center p-4">
                <span class="uppercase text-sm  text-blue-600 font-medium">( 01 - Formulario de contacto )</span>
                <small class="uppercase text-xs text-neutral-600 dark:text-neutral-400">* Obligatorio</small>
            </div>

            <div class="flex flex-col p-4  gap-y-2  focus-within:bg-neutral-100 dark:focus-within:bg-neutral-900 transition-colors duration-200"  >
                <label class="text-xs  uppercase text-neutral-600 dark:text-neutral-400">
                    <b class="text-blue-600 mr-1 font-medium">01</b> Tu nombre o empresa *
                </label> 
                <input type="text" id="client" name="client" placeholder="Ej: Toromac" autocomplete="organization" minlength="2" maxlength="80" class="text-xl outline-0" required>
            </div>
            
            <fieldset class="flex flex-col">
                <legend class="text-xs uppercase text-neutral-600 dark:text-neutral-400 p-4">
                    <b class="text-blue-600 mr-1 font-medium">02</b> 
                    Tipo de proyecto *
                </legend>

                <div class="grid grid-cols-1 divide-y divide-neutral-300 dark:divide-neutral-800">

                    <label class="flex flex-row justify-between items-center py-4 px-8  cursor-pointer  has-[input:checked]:bg-blue-600 has-[input:checked]:text-white transition-all duration-200 group">
                        <div class="flex">
                            <input type="radio" class="appearance-none" value="Landing Page" name="projectType" required>
                            <span class="uppercase font-anton group-hover:-translate-x-4 text-2xl transition-transform duration-200">Landing Page</span>
                        </div>
                        <span class="flex text-sm uppercase font-medium flex-row items-center gap-x-2">
                            Desde 
                            <span class="price">150 USD</span>
                            <ArrowRight class="group-hover:translate-x-2 group-hover:-translate-y-0.5 duration-200" />
                        </span>
                    </label>

                    <label class="flex flex-row justify-between items-center py-4 px-8 cursor-pointer has-[input:checked]:bg-blue-600 has-[input:checked]:text-white group transition-all duration-200 ">
                        <div class="flex">
                            <input type="radio" class="appearance-none" value="Web Institucional" name="projectType">
                            <span class="uppercase font-anton group-hover:-translate-x-4 text-2xl transition-transform duration-200 ">Web Institucional</span>
                        </div>
                        <span class="flex text-sm uppercase font-medium  flex-row items-center gap-x-2">
                            Desde 
                            <span class="price">200 USD</span>
                            <ArrowRight class="group-hover:translate-x-2 group-hover:-translate-y-0.5 duration-200" />
                        </span>
                    </label>

                    <label class="flex flex-row justify-between items-center py-4 px-8 cursor-pointer has-[input:checked]:bg-blue-600 has-[input:checked]:text-white transition-all duration-200 group">
                        <div class="flex">
                            <input type="radio" class="appearance-none" value="E-Commerce" name="projectType">
                            <span class="uppercase font-anton group-hover:-translate-x-4 text-2xl transition-transform duration-200">E-Commerce <small class="text-[10px] md:text-xs">(WooCommerce)</small></span>
                        </div>
                        <span class="flex text-sm uppercase font-medium flex-row items-center gap-x-2">
                            Desde 
                            <span class="price">250 USD</span>
                            <ArrowRight class="group-hover:translate-x-2 group-hover:-translate-y-0.5 duration-200" />
                        </span>
                    </label>

                </div>
            </fieldset>

            <div class="flex flex-col p-4 gap-y-2 focus-within:bg-neutral-100 dark:focus-within:bg-neutral-900 transition-colors duration-200">
                <label class="text-xs  uppercase text-neutral-600 dark:text-neutral-400">
                    <b class="text-blue-600 mr-1 font-medium">03</b> Contexto del proyecto (Opcional)
                </label>
                <textarea name="context" maxlength="200" id="context" minlength="10" placeholder="Qué vendés, a quién y qué querés lograr" class="text-xl outline-0"></textarea>
            </div>
        </div>
            <aside class="bg-blue-600 p-4 flex flex-col">
                <p class="text-xs text-white font-medium gap-x-2 flex items-center uppercase">
                    <PulseDot color="white" />
                    ( Tu brief · en vivo )
                </p>
                <dl class="flex flex-col gap-4 my-10">
                    <div>
                        <dt class="uppercase text-gray-300 font-medium text-xs md:text-sm">Cliente</dt>
                        <dd id="client-brief" class="border-b border-neutral-300/40 font-anton uppercase text-white text-2xl pb-1">—</dd>
                    </div>
                    <div>
                        <dt class="uppercase text-gray-300 font-medium text-xs md:text-sm">Proyecto</dt>
                        <dd id="project-brief" class="border-b border-neutral-300/40 font-anton uppercase text-white text-2xl  pb-1">—</dd>
                    </div>
                    <div>
                        <dt class="uppercase text-gray-300 font-medium text-xs md:text-sm">Inversión desde</dt>
                        <dd id="price-brief" class=" font-anton uppercase text-white text-4xl md:text-6xl  py-3">—</dd>
                    </div>
                </dl>
                <div class="flex flex-col mt-auto gap-4">
                    <button type="submit" class="flex items-center justify-between gap-4 text-left text-white font-anton uppercase text-xl bg-black p-4 cursor-pointer hover:bg-white hover:text-blue-600 group transition-all duration-200">
                        Solicitar presupuesto por WhatsApp
                        <ArrowRight class="shrink-0 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform duration-200" />
                    </button>
                    <p class="text-xs text-white/80">Se abre WhatsApp con tu brief listo para enviar.</p>
                </div>
            </aside>
    </form>


</section>


    <script>
        import '../scripts/Contact.js'; 
    </script>