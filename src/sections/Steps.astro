---
import PulseDot from '../components/PulseDot.astro';

const navSteps = [
    {
        step: '01',
        stepLabel: 'Paso 01',
        stepTitle: 'Estructura',
    },
    {
        step: '02',
        stepLabel: 'Paso 02',
        stepTitle: 'Diseño',
    },
    {
        step: '03',
        stepLabel: 'Paso 03',
        stepTitle: 'Desarrollo',
    },
    {
        step: '04',
        stepLabel: 'Paso 04',
        stepTitle: 'Lanzamiento',
    },
]
const steps = [
    {
        step: '01',
        stepTitle: 'Estructura',
        stepLabel: 'Estructura y diagnostico',
        StepLabels: [
            'Diagnostico,',
            'Plan de trabajo,',
            'Cotizacion',
        ],
        stepDescription: 'Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quos.',
        stepImage: 'https://via.placeholder.com/150',
        stepTime: '1 semana',
        stepDeliverables: [
            'Documento de diagnostico',
            'Plan de trabajo',
            'Cotizacion',
        ]
    },
    {
        step: '02',
        stepTitle: 'Diseño',
        stepLabel: 'Diseño y desarrollo',
        StepLabels: [
            'Diagnostico',
            'Plan de trabajo',
            'Cotizacion',
        ],
        stepDescription: 'Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quos.',
        stepImage: 'https://via.placeholder.com/150',
        stepTime: '1 semana',
        stepDeliverables: [
            'Documento de diagnostico',
            'Plan de trabajo',
            'Cotizacion',
        ]
    },
]
---


<section class="py-5 px-3">
    <h2 class="font-anton uppercase text-4xl text-center px-3 py-10">
        Proceso de trabajo
    </h2>
    <div class="border border-neutral-200/50 bg-neutral-50 md:flex rounded-md p-4 max-w-425 mx-auto justify-between gap-x-10 items-center">
        <ol class="flex flex-row justify-between md:justify-start md:flex-1 gap-x-10">
            {navSteps.map((step) => (
                <li aria-current="step" class="flex flex-col md:flex-row items-center md:gap-x-7 ">
                    <span class="border border-neutral-300 text-black/30 p-2 rounded-full items-center justify-center font-anton">{step.step}</span>
                    <div class="flex flex-col text-black/30 font-grotesk ">
                    <span class="hidden md:block">{step.stepLabel}</span>
                    <span class="hidden md:block">{step.stepTitle}</span>
                    </div>
                </li>
            ))}
        </ol>
        <div class="flex flex-row items-center mt-5 md:mt-0 gap-x-5 md:flex-1 font-grotesk">
            <label class="shrink-0 text-sm md:text-base opacity-50">Progreso</label>
            <div class="w-full h-1.5 rounded-full bg-neutral-200 relative">
                <div class="absolute top-0 left-0 h-full bg-blue-600 dark:bg-blue-400 rounded-full" style="width: 25%;"></div>
            </div>
            <span class="text-sm md:text-base font-light">25%</span>
        </div>
    </div>
    <div role="tablist" class="gap-3  mx-auto mt-10 flex flex-col  md:flex-row md:max-w-425">
        {steps.map((step) => (
            <div class="grid md:h-140 overflow-hidden relative ">

                <button role="tab" data-step-button aria-controls={`step-${step.step}`} class="cursor-pointer flex flex-col p-3 gap-y-3 dots-bg border border-neutral-200 ">
                    
                    <!--Boton en Mobile -->
                    <span class="flex items-center gap-x-2 font-grotesk text-black/50 md:hidden">
                        <PulseDot data-pulse color="blue-600" />
                        <span class="text-sm">Paso {step.step} — {step.stepLabel}</span>
                    </span>
                    <span class="font-anton text-xl flex tracking-wider uppercase md:hidden"> {step.stepTitle}</span>
                    <span class="flex gap-1 flex-wrap -mt-2 md:hidden">{step.StepLabels.map((label) => (
                        <span class="text-xs font-grotesk text-black/70">{label}</span>
                    ))}</span>
                    <div class="overflow-hidden md:hidden h-0 w-full" data-panel-wrapper >
                        <span role="tabpanel" class="flex flex-col text-start font-grotesk">
                            <span class=" text-black/70">{step.stepDescription}</span>
                            <span class="flex flex-col mt-6">
                                <span class="text-sm uppercase tracking-wider">Fases de la entrega:</span>
                                <span class="text-sm flex flex-col gap-y-1 mt-2 text-black/70">{step.stepDeliverables.map((deliverable) => (
                                    <span> - {deliverable}</span>
                                ))}</span>
                            </span>
                        </span>
                    </div>
                    <span class="flex justify-between items-center font-grotesk md:hidden">
                        <span class="text-sm text-black/50">Paso {step.step}/04</span>
                        <span class="text-xl" data-icon>↓</span>
                    </span>

                    <!--Boton en Desktop -->
                    <span class="hidden md:flex justify-between items-center flex-col h-full">
                        <span class="font-anton text-2xl tracking-wider"> {step.step}</span>
                        <span class="[writing-mode:vertical-lr] text-sm text-black/50 font-grotesk uppercase tracking-wider"> {step.stepLabel}</span>
                        <span class="text-xl">+</span>
                    </span>
                    <div class="hidden md:block w-0 overflow-hidden " data-panel>
                        <div class=" inset-0">
                            <div class="flex flex-col p-3 gap-y-3  ">
                                {step.step} lor Lorem ipsum dolor sit amet consectetur, adipisicing elit. Quidem, necessitatibus! Sapiente sequi, maiores officiis assumenda omnis officia consequuntur. Vel nihil tempora, alias sapiente officia porro ut fugit. Ex, aperiam nostrum.
                            </div>
                        </div>
                    </div>
                </button>
            </div>
        ))}
    </div>
</section>
<script> 
        import '../scripts/Steps.js';
</script>
