---
import PulseDot from '../components/PulseDot.astro';

const navSteps = [
    {
        step: '01',
        stepLabel: 'Paso 01',
        stepTitle: 'Estructura',
    },
    {
        step: '02',
        stepLabel: 'Paso 02',
        stepTitle: 'Diseño',
    },
    {
        step: '03',
        stepLabel: 'Paso 03',
        stepTitle: 'Desarrollo',
    },
    {
        step: '04',
        stepLabel: 'Paso 04',
        stepTitle: 'Lanzamiento',
    },
]
const steps = [
    {
        step: '01',
        stepTitle: 'Estructura',
        stepLabel: 'Estructura y diagnostico',
        stepLabels: [
            '#Briefing',
            '#Diagnostico',
            '#Plan de trabajo',
        ],
        stepDescription: 'Primero lo primero: quiero entender bien tu negocio, a quién le vendes y qué necesitas lograr exacto. Nos sentamos a revisar tus ideas, resolvemos dudas iniciales y definimos la hoja de ruta para que ambos sepamos hacia dónde vamos desde el día uno.',
        stepImage: 'https://via.placeholder.com/150',
        stepDeliverables: [
            'Documento de Briefing',
            'Cronograma de trabajo',
            'Cotizacion',
        ]
    },
    {
        step: '02',
        stepTitle: 'Diseño',
        stepLabel: 'Forma visual',
        stepLabels: [
            '#Diseño',
            '#UX/UI',
            '#Prototipo',
        ],
        stepDescription: 'Aquí es donde la idea cobra vida. Diseñamos la estructura y la apariencia de tu proyecto para que veas cómo va a interactuar tu cliente antes de programar nada. Ajustamos los detalles visuales juntos hasta que quedes 100% conforme.',
        stepImage: 'https://via.placeholder.com/150',
        stepDeliverables: [
            'Proyecto en Figma',
            'Mockups',
        ]
    },
    {
        step: '03',
        stepTitle: 'Desarrollo',
        stepLabel: 'Programacion y desarrollo',
        stepLabels: [
            '#Programacion',
            '#Codigo',
            '#Dev',
        ],
        stepDescription: 'Ya con el diseño aprobado, me pongo a construir. Escribo código limpio, rápido y seguro, conectando todas las herramientas que tu proyecto necesita para funcionar sin fallas ni sorpresas.',
        stepImage: 'https://via.placeholder.com/150',
        stepDeliverables: [
            'Codigo fuente',
            'Testing',
            'Enlace privado',
        ]
    },
    {
        step: '04',
        stepTitle: 'Lanzamiento',
        stepLabel: 'Presentacion y lanzamiento',
        stepLabels: [
            '#QA',
            '#Lanzamiento',
            '#Entrega',
        ],
        stepDescription: 'Hacemos las últimas pruebas para asegurarnos de que todo cargue rápido y vuele. Publicamos el proyecto, te entrego todos los accesos y te enseño a gestionarlo para que tengas el control total desde el primer segundo.',
        stepImage: 'https://via.placeholder.com/150',
        stepDeliverables: [
            'Enlace publico',
            'Accesos',
            'Codigo 100% propio',
        ]
    }

]
---


<section class="py-5 px-3">
    <h2 class="font-anton uppercase text-4xl text-center px-3 py-10">
        Proceso de trabajo
    </h2>
    <div class="border border-neutral-200/50 bg-neutral-50 md:flex rounded-md p-4 max-w-425 mx-auto justify-between gap-x-10 items-center">
        <ol class="flex flex-row justify-between md:justify-start md:flex-1 gap-x-10">
            {navSteps.map((step) => (
                <li data-step-nav class="group flex flex-col md:flex-row items-center md:gap-x-7 opacity-50 aria-[current=step]:opacity-100 transition-opacity duration-300">
                    <span class="border border-neutral-300 text-gray-600 p-2 rounded-full items-center justify-center font-anton transition-colors duration-300 group-aria-[current=step]:border-blue-600 group-aria-[current=step]:text-blue-600">{step.step}</span>
                    <div class="flex flex-col text-black/30 font-grotesk transition-colors duration-300 group-aria-[current=step]:text-black">
                    <span class="hidden md:block group-aria-[current=step]:font-bold">{step.stepLabel}</span>
                    <span class="hidden md:block">{step.stepTitle}</span>
                    </div>
                </li>
            ))}
        </ol>
        <div class="flex flex-row items-center mt-5 md:mt-0 gap-x-5 md:flex-1 font-grotesk">
            <label class="shrink-0 text-sm md:text-base uppercase tracking-widest opacity-50">Progreso</label>
            <div class="w-full h-1.5 rounded-full bg-neutral-200 relative">
                <div data-progress-bar class="absolute top-0 left-0 h-full bg-blue-600 dark:bg-blue-400 rounded-full" style="width: 0%;"></div>
            </div>
            <span data-progress-label class="text-sm md:text-base font-light">0%</span>
        </div>
    </div>
    <div role="tablist" class="gap-3 mx-auto mt-10 flex flex-col md:grid md:perspective-distant md:grid-cols-4  max-w-425">
        {steps.map((step, index) => (
            <div class="grid w-full md:h-140 md:overflow-hidden relative ">

                <button role="tab" data-step-button data-step-index={index} aria-controls={`step-${step.step}`} class="cursor-pointer flex flex-col p-3 gap-y-3 dots-bg border border-neutral-200 md:relative md:rounded-md md:grid md:transform-3d">
                    
                    <!--Boton en Mobile -->
                    <span class="flex items-center gap-x-2 font-grotesk text-gray-600 md:hidden">
                        <PulseDot data-pulse color="blue-600" />
                        <span class="text-sm">Paso {step.step} — {step.stepLabel}</span>
                    </span>
                    <span class="font-anton text-xl flex tracking-wider uppercase md:hidden"> {step.stepTitle}</span>
                    <span class="flex gap-1 flex-wrap -mt-2 md:hidden">{step.stepLabels.map((label) => (
                        <span class="text-xs font-grotesk text-gray-600">{label}</span>
                    ))}</span>
                    <div class="overflow-hidden md:hidden h-0 w-full" data-panel-wrapper >
                        <span role="tabpanel" class="flex flex-col text-start font-grotesk">
                            <span class=" text-gray-600">{step.stepDescription}</span>
                            <span class="flex flex-col mt-6">
                                <span class="text-sm uppercase tracking-wider">Fases de la entrega:</span>
                                <span class="text-sm flex flex-col gap-y-1 mt-2 text-gray-600">{step.stepDeliverables.map((deliverable) => (
                                    <span> - {deliverable}</span>
                                ))}</span>
                            </span>
                        </span>
                    </div>
                    <span class="flex justify-between items-center font-grotesk md:hidden">
                        <span class="text-sm text-black/50">Paso {step.step}/04</span>
                        <span class="text-xl" data-icon>↓</span>
                    </span>

                    <!--Boton en Desktop -->
                    <span data-panel-button class="hidden md:flex justify-between items-center flex-col h-full md:absolute md:inset-0 md:backface-hidden">
                        <span class="font-grotesk font-bold text-3xl mt-10 tracking-wider"> {step.step}</span>
                        <span class="[writing-mode:vertical-lr] text-md text-black/50 font-grotesk uppercase tracking-wider"> {step.stepLabel}</span>
                        <span class="text-xl mb-10">+</span>
                    </span>
                    <div data-panel-desktop class="hidden md:block overflow-hidden md:absolute md:inset-0 md:p-10 md:backface-hidden md:rotate-y-180">
                        <div class="flex flex-col items-start font-grotesk">
                            <span class="absolute top-0 right-0">
                                <span class="text-8xl text-gray-600/10 font-anton uppercase tracking-wider"> 
                                    {step.step}
                                </span>
                            </span>
                            <span class="flex flex-row items-center gap-x-2  text-gray-600">
                                <PulseDot class="size-10" color="blue-600"/>
                                <span>
                                    Paso {step.step} — {step.stepLabel}
                                </span>
                            </span>

                            <span class="font-anton mt-2 text-3xl uppercase tracking-wider"> 
                                {step.stepTitle}
                            </span>
                            <span class="flex flex-row gap-x-2">
                                {step.stepLabels.map((label) => (
                                    <span class="text-xs text-gray-600">{label}</span>
                                ))}
                            </span>
                            <span class="text-start text-balance mt-15 text-gray-800">
                                {step.stepDescription}
                            </span>
                            <span class="text-sm uppercase tracking-wider mt-10">
                                Fases de la entrega:
                            </span>
                            <span class="text-sm flex flex-col items-start gap-y-1 mt-2 text-gray-600">
                                {step.stepDeliverables.map((deliverable) => (
                                    <span> - {deliverable}</span>
                                ))}
                            </span>
                        </div>
                    </div>
                </button>
            </div>
        ))}
    </div>
</section>
<script> 
        import '../scripts/Steps.js';
</script>
