---
import ArrowHero from '../assets/svgs/ArrowHero.svg'
import WebHero from '../assets/svgs/WebHero.svg'
import IAHero from '../assets/svgs/IAHero.svg'

import ArrowDown from '../assets/svgs/ArrowDown.svg'
---

<section data-hero id="hero" class="invisible flex-col flex justify-center min-h-[91vh] overflow-hidden z-10 px-2">
    <div class="mx-auto flex w-full max-w-[1900px] flex-col items-center gap-y-5">
        <span data-hero-subtitle class="text-center pointer-events-none text-neutral-500 dark:text-neutral-400 text-sm font-grotesk tracking-tighter">
            Para marcas, negocios y profesionales que quieren escalar.
        </span>
        <h1 class="uppercase font-anton pointer-events-none text-center items-center flex flex-col text-[42px] text-balance z-10 leading-18 md:text-7xl md:leading-38 2xl:text-[clamp(96px,8vw,150px)] xl:leading-50">
            
            <span>
                <span data-hero-web-text class="overflow-hidden">Webs</span>
                    <span data-hero-web class="inline-flex items-center justify-center p-1 rounded-lg bg-blue-500">
                        <WebHero class="size-7 md:size-20 2xl:size-30 text-white dark:text-black" />
                    </span>
                <span data-hero-web-text class="overflow-hidden">que marcan</span>
            </span>

            <span >
                <span data-hero-ia-text class="overflow-hidden">IA </span>
                    <span data-hero-ia class="inline-flex">
                        <IAHero class="size-9 md:size-20 2xl:size-30 p-1 text-gray-500 rotate-8 dark:" />
                    </span>
                <span data-hero-ia-text class="overflow-hidden">que automatiza</span>
            </span>

            <span>
                <span data-hero-arrow-text class="text-[#3B82F6] overflow-hidden">Negocios</span>
                    <span data-hero-arrow class="inline-flex p-1 bg-black dark:bg-white rounded-lg -rotate-8">
                        <ArrowHero class="size-7 md:size-20 2xl:size-30 text-white dark:text-black" />
                    </span>
                <span data-hero-arrow-text class="text-blue-500 overflow-hidden">que crecen</span>
            </span>
        </h1>
        <div class="flex flex-col md:flex-row gap-6 font-grotesk uppercase text-sm md:text-base font-medium">


        <a href="#" data-hero-btn class="w-full group inline-flex overflow-hidden h-10 px-3 gap-x-2 items-center dark:text-black text-white border border-black/30 dark:border-white/30 bg-black dark:bg-white relative group">
            <span class="bg-white dark:bg-black absolute inset-0 translate-y-20 ease group-hover:translate-y-0 transition-transform duration-500 ease-in-out"></span>
            <span class="group-hover:text-black dark:group-hover:text-white relative z-10 transition-all duration-200">
                Empezar proyecto
            </span>
            <ArrowDown class="size-6 z-20 group-hover:text-black dark:group-hover:text-white transition-colors duration-200" />
        </a>

        <a href="#"data-hero-btn class="inline-flex relative group text-nowrap items-center justify-center h-10 group">
            Ver casos reales
            <span class="underline h-0.5 w-full absolute bottom-0 left-0 bg-black origin-left dark:bg-white scale-x-100 md:scale-x-0 group-hover:scale-x-100 transition-transform duration-200 ease-in-out"></span>
        </a>
        </div>
        
    </div>
</section>
<script>
        import '../scripts/Hero.js';
    </script>
