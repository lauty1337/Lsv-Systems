---
import ArrowHero from '../assets/svgs/ArrowHero.svg'
import WebHero from '../assets/svgs/WebHero.svg'
import IAHero from '../assets/svgs/IAHero.svg'

import ArrowDown from '../assets/svgs/ArrowDown.svg'
---

<section data-hero class="invisible flex-col flex justify-center min-h-[85vh] md:min-h-[92dvh] overflow-hidden z-10 px-2">
    <div class="flex flex-col items-center gap-y-5 2xl:w-[1900px] 2xl:mx-auto">
        <span data-hero-subtitle class="text-center text-neutral-500 dark:text-neutral-400 text-sm font-grotesk tracking-tighter">
            Web & Automatización con IA
        </span>
        <h1 class="uppercase font-anton text-center items-center flex flex-col text-[42px] text-balance z-10 leading-18 md:leading-38 md:text-8xl 2xl:text-[150px] xl:leading-50">
            
            <span>
                <span data-hero-web-text class="overflow-hidden">Webs</span>
                    <span data-hero-web class="inline-flex items-center justify-center p-1 rounded-lg bg-blue-500">
                        <WebHero class="size-7 md:size-20 2xl:size-30 text-white dark:text-black" />
                    </span>
                <span data-hero-web-text class="overflow-hidden">que marcan</span>
            </span>

            <span class="md:self-start">
                <span data-hero-ia-text class="overflow-hidden">IA </span>
                    <span data-hero-ia class="inline-flex">
                        <IAHero class="size-9 md:size-20 2xl:size-30 p-1 text-gray-500 rotate-8 dark:" />
                    </span>
                <span data-hero-ia-text class="overflow-hidden">que automatiza</span>
            </span>

            <span class="md:self-end">
                <span data-hero-arrow-text class="text-blue-500 overflow-hidden">Negocios</span>
                    <span data-hero-arrow class="inline-flex p-1 bg-black dark:bg-white rounded-lg -rotate-8">
                        <ArrowHero class="size-7 md:size-20 2xl:size-30 text-white dark:text-black" />
                    </span>
                <span data-hero-arrow-text class="text-blue-500 overflow-hidden">que crecen</span>
            </span>
        </h1>
        <a href="#" data-hero-btn class="inline-flex gap-3 group font-grotesk items-center justify-center px-3 py-1.5 text-sm bg-black text-white dark:bg-white dark:text-black md:text-lg font-medium transition-all duration-200 hover:bg-neutral-700 dark:hover:bg-neutral-400">
            Empezar proyecto
            <span class="pl-3 border-l border-white/30 dark:border-black/30 ">
            <ArrowDown class="group-hover:translate-y-1 size-5 transition-transform duration-200"/>
            </span>
        </a>
    </div>
    
</section>
<script>
        import '../scripts/Hero.js';
    </script>
