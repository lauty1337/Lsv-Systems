---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo-mastercred.webp'

import LogoSVG from '../assets/svgs/LogoSVG.svg'
import ArrowRight from '../assets/svgs/ArrowRight.svg'
import Moon from '../assets/svgs/Moon.svg'
import Sun from '../assets/svgs/Sun.svg'
---

<header class="sticky top-0 z-300 p-3 grid grid-cols-[1fr_auto_1fr] items-center transition-transform duration-300">

    <div data-toggler-theme class="flex items-center justify-self-start gap-0.5 p-0.5 hover:-rotate-4 bg-black dark:bg-white transition-all duration-200">

        <button data-theme-btn="dark" aria-label="Activar tema oscuro" class="cursor-pointer p-2.5 group bg-neutral-400 data-[active=true]:bg-black/90 hover:bg-black/90  transition-colors duration-200"> 
            <Moon class="size-4  text-gray-500 group-data-[active=true]:text-white group-hover:text-white transition-colors duration-200" /> 
        </button>
        <button data-theme-btn="light" aria-label="Activar tema claro" class="cursor-pointer p-2.5 group bg-neutral-400  data-[active=true]:bg-amber-500 hover:bg-amber-500  transition-colors duration-200"> 
            <Sun class="size-4  text-gray-500 group-data-[active=true]:text-white group-hover:text-white transition-colors duration-200" /> 
        </button>
    </div>

        <LogoSVG class="block justify-self-center size-14 md:size-16 fill-current" />

    <div class="relative justify-self-end w-24 h-11">
        <div class="absolute top-0 right-0 flex flex-col items-stretch">
            <button data-nav-toggler aria-expanded="false" class="bg-black dark:bg-white noise p-1 flex items-center justify-start gap-1 group cursor-pointer h-11">

                <div class="flex flex-col h-9 justify-between gap-0.5 px-2 py-3 bg-white dark:bg-black group-hover:py-2 transition-all duration-200">
                    <span aria-hidden="true" data-line-top class="bg-line"></span>
                    <span aria-hidden="true" data-line-mid class="bg-line"></span>
                    <span aria-hidden="true" data-line-bot class="bg-line"></span>
                </div>
                
                <div class="relative inline-block overflow-hidden h-5 w-15 text-white dark:text-black font-anton uppercase px-0.5">
                    <span data-label-menu class="absolute inset-0 flex items-center justify-center">Menu</span>
                    <span data-label-close class="absolute inset-0 flex items-center justify-center translate-y-full">Cerrar</span>
                </div>

            </button>
            <nav data-menu-header class="overflow-hidden border opacity-0 pt-3 invisible dark:bg-gray-200 bg-[#111111] dark:border-white border-black">
                <ul class="gap-y-3 flex flex-col text-5xl">

                    <li><a href="/#hero" data-nav-item class="nav-link hover:rotate-2 ">Inicio</a></li>
                    <li><a href="/#services" data-nav-item class="nav-link hover:-rotate-2 ">Servicios</a></li>
                    <li><a href="/#projects" data-nav-item class="nav-link hover:rotate-2 ">Proyectos</a></li>
                    <li><a href="/#about" data-nav-item class="nav-link hover:-rotate-2 ">Nosotros</a></li>
                    <li><a href="/#contact" data-nav-item class="nav-link hover:rotate-2 ">Contacto</a></li>
                    <li>
                        <a href="" data-nav-item class="pl-1 inline-flex items-center group gap-2 opacity-40 hover:opacity-100 transition-all duration-200 w-full justify-between">
                            <div class="flex items-center gap-2">
                            <Image src={logo} alt="Logo de Mastercred" title="Logo de Mastercred" class="size-7 md:size-8" />

                            <span class="flex flex-col gap-0.5">
                                <span class="text-xs font-grotesk dark:text-black/70 text-white/70">Ultimo Proyecto</span>
                                <span class="text-sm font-anton text-white dark:text-black tracking-tighter uppercase ">MasterCred</span>
                            </span>
                            </div>
                            <ArrowRight class="size-7 dark:text-black text-white mr-2 group-hover:translate-x-1 group-hover:-translate-y-1 transition-all duration-200" />
                        </a>
                    </li>
                    
                </ul>   
            </nav>
        </div>
    </div>
</header>

<script>
	import '../scripts/Header.js';
</script>