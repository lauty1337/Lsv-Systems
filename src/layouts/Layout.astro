---
import '../styles/global.css';
import Header from '../sections/Header.astro';
import Footer from '../sections/Footer.astro';


---
<!doctype html>
<html lang="es" class="scroll-smooth ">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/LSV.ico" />
		<title>LSV Systems | Desarrollo web y automatización de procesos</title>
		<meta name="description" content="LSV Systems es una agencia digital de desarrollo web y automatización de procesos. Ofrecemos soluciones personalizadas para marcas, negocios y profesionales que quieren escalar." />
		<meta name="keywords" content="LSV Systems, Agencia digital, Desarrollo web, automatizacion de procesos, Desarrollo de E-Commerces, Desarrollo de Landing Pages, SEO, " />
		<meta name="author" content="LSV Systems" />
		<meta name="robots" content="index, follow" />
		<meta name="googlebot" content="index, follow" />
		<meta name="bingbot" content="index, follow" />
		<meta name="yandexbot" content="index, follow" />

		<script is:inline>
			(() => {
				const stored = localStorage.getItem('theme');
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				const isDark = stored ? stored === 'dark' : prefersDark;
				document.documentElement.classList.toggle('dark', isDark);
			})();
		</script>

	</head>
	<body class=" text-black dark:text-white/90 dark:bg-black transition-colors duration-300 ease-out">

		<Header />	
		    <main class="flex-1 flex flex-col">
			    <slot />
		    </main>
		<Footer />

		<script>
			import '../scripts/lenis.js';
		</script>
	</body>
</html>


