---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import  PulseDot  from '../../components/PulseDot.astro';
import ArrowRight from '../../assets/svgs/ArrowRight.svg'
import WhatsAppIcon from '../../assets/svgs/WhatsApp.svg'
export async function getStaticPaths() {
    const projects = await getCollection('projects');

    return projects.map((entry) => ({
        params: { project: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, titleLabel, titleSEO, descriptionSEO, descriptionLabel, year, time, tags, url, imgCaseStudy } = entry.data;
---

<Layout title={`${titleSEO}`} description={descriptionSEO} >
        <article class="py-10">

            <header class="flex flex-col justify-center items-center gap-y-3 mb-30">
                <div  class="flex flex-col items-center font-medium text-xs uppercase gap-2 md:flex-row md:text-sm z-20">
                    <span data-project-label class="py-1 px-4 bg-black dark:bg-white text-white dark:text-black flex items-center gap-x-2">
                        <PulseDot color="green-600" />
                        Estado: Activo
                    </span>
                    <div class="flex gap-x-2">
                        <span data-project-label class="py-1 px-4 text-blue-400 border border-blue-400 bg-blue-950"> Conversión 100%</span>
                        <span data-project-label class="py-1 px-4 border border-neutral-400 bg-white dark:bg-black dark:border-neutral-600">Astro Build</span>
                    </div>
                </div>
                <h1 class="font-anton uppercase tracking-tighter leading-none text-[88px] md:text-[320px] flex "transition:name={`project-${entry.id}-title`}>{title}</h1>
                <p class="font-medium  uppercase text-gray-600 dark:text-gray-300 text-center text-md md:text-2xl" data-project-description>{descriptionLabel}</p> 
            </header>

            <main class="grid grid-cols-1 gap-10 px-3 md:grid-cols-2 md:mx-auto md:max-w-425  ">
                <div class="gap-y-5 flex flex-col">
                    <span class="font-medium uppercase text-sm text-blue-600 md:text-base ">
                        ( Especificaciones )
                    </span>
                    <h2 class="font-anton uppercase text-3xl md:text-5xl">
                        {titleLabel}
                    </h2>
                    <p class="font-medium text-gray-600 dark:text-gray-300 text-md md:text-lg text-balance ">
                        {descriptionSEO}
                    </p>
                    <dl class="border uppercase border-neutral-200 dark:border-neutral-600 divide-y divide-neutral-300/50 dark:divide-neutral-800 dots-bg">
                        <div class="flex justify-between p-3">
                            <dt class="text-gray-600 dark:text-gray-400">Cliente</dt>
                            <dd class="font-medium">{title}</dd>
                        </div>
                        <div class="flex justify-between p-3">
                            <dt class="text-gray-600 dark:text-gray-400">Plazo de entrega</dt>
                            <dd class="font-medium text-blue-600">{time}</dd>
                        </div>
                        <div class="flex justify-between p-3">
                            <dt class="text-gray-600 dark:text-gray-400">Performance</dt>
                            <dd class="font-medium">100%</dd>
                        </div>
                        <div class="flex justify-between p-3">
                            <dt class="text-gray-600 dark:text-gray-400">Stack Tecnológico</dt>
                            <dd class="font-medium">
                                <ul class="flex flex-row gap-x-2 gap-y-1">
                                    <li>TailwindCSS </li>
                                    <li>Astro.js</li>
                                    <li>GSAP</li>
                                </ul>
                            </dd>
                        </div>
                    </dl>
                    <a href={url} target="_blank" rel="noopener noreferrer" class="bg-black dark:bg-white text-white dark:text-black py-3 px-4 font-medium uppercase flex justify-center  gap-x-2 md:w-1/2 hover:bg-neutral-700 dark:hover:bg-neutral-300 transition-all duration-200 group" >
                        Visitar página web 
                        <ArrowRight class="group-hover:translate-x-2 transition-all duration-200" />

                    </a>
                </div>
                <Image src={imgCaseStudy} alt={title} class="border border-black/20" />
            </main>
        </article>
        <div class="mx-auto max-w-380 px-3 md:px-0 py-10">
            <div class="p-5 md:p-10 border rounded-lg border-black dark:border-white/20 flex flex-col gap-y-5 md:flex-row">
                <div class="flex flex-col gap-y-5 md:w-1/2">
                    <span class="font-medium uppercase text-sm text-blue-600 md:text-base">
                        ( Contacto directo a Lsv Systems © )
                    </span>
                    <h2 class="font-anton uppercase text-3xl md:text-5xl">
                        ¿Querés una web como esta para tu negocio?
                    </h2>
                    <p class="text-gray-600 dark:text-gray-300 text-pretty text-md ">
                        Si preferís coordinar una llamada o consulta directa sin formularios, podés iniciarla en este momento.
                    </p>
                    <div class="grid grid-cols-2 md:flex gap-3">
                        <div class="flex flex-col gap-y-1 p-3 bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800">
                            <span class="uppercase text-gray-600 dark:text-gray-400 text-sm md:text-base">
                                Tiempo de entrega
                            </span>
                            <span class="font-medium">
                                1-2 Semanas
                            </span>
                        </div>
                        <div class="flex flex-col gap-y-1 p-3 bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800">
                            <span class="uppercase text-gray-600 dark:text-gray-400 text-sm md:text-base">
                                Trato
                            </span>
                            <span class="font-medium">
                                1:1 Directo
                            </span>
                        </div>
                        <div class="flex flex-col col-span-2 gap-y-1 p-3 bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800">
                            <span class="uppercase text-gray-600 dark:text-gray-400 text-sm md:text-base">
                                Rendimiento
                            </span>
                            <span class="font-medium text-blue-600">
                                99.9% Uptime
                            </span>
                        </div>
                    </div>
                    <p class="font-medium hidden  uppercase md:flex items-center text-sm gap-x-2">
                        <PulseDot color="green-600"/>
                        Disponible para nuevos proyectos.
                    </p>
                </div>
                <div class="flex flex-col gap-y-3  mt-4 ">
                    <div class="bg-gray-100 dark:bg-neutral-900 p-3 border border-neutral-200 dark:border-neutral-800">
                        <div class="flex justify-between">
                            <span class="flex items-center gap-x-2 uppercase text-sm ">
                                <PulseDot color="green-600" />
                                En linea ahora
                            </span>
                            <p class="text-gray-600 dark:text-gray-400 text-sm">
                                Resp. habitual 15 min
                            </p>
                        </div>
                        <div class="flex flex-col md:flex-row gap-4 mt-5">
                            <span class="flex items-center gap-x-2 font-medium">
                                <WhatsAppIcon class="size-5 text-black dark:text-white " />
                                <p>Escribime directo</p>
                            </span>
                            <a href="https://wa.me/5491133333333" target="_blank" rel="noopener noreferrer" class="flex items-center px-4 py-2 justify-center gap-x-2 bg-emerald-200 border-emerald-600 dark:bg-emerald-900 border dark:border-emerald-600 hover:bg-emerald-400 dark:hover:bg-emerald-800 transition-all duration-200 uppercase group">
                                Escribir por WhatsApp
                                <ArrowRight class="size-5 text-black dark:text-white group-hover:translate-x-2 transition-all duration-200 " />
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
</Layout>
