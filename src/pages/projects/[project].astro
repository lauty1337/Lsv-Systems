---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import  PulseDot  from '../../components/PulseDot.astro';
import ArrowRight from '../../assets/svgs/ArrowRight.svg'
export async function getStaticPaths() {
    const projects = await getCollection('projects');

    return projects.map((entry) => ({
        params: { project: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, titleLabel, titleSEO, descriptionSEO, descriptionLabel, year, time, tags, url, imgCaseStudy } = entry.data;
---

<Layout title={`${titleSEO}`} description={descriptionSEO} >
        <article class="py-10">

            <header class="flex flex-col justify-center items-center gap-y-3 mb-30">
                <div  class="flex flex-col items-center font-medium text-xs uppercase gap-2 md:flex-row md:text-sm">
                    <span data-project-label class="py-1 px-4 bg-black dark:bg-white text-white dark:text-black flex items-center gap-x-2">
                        <PulseDot color="green-600" />
                        Estado: Activo
                    </span>
                    <div class="flex gap-x-2">
                        <span data-project-label class="py-1 px-4 text-blue-600 border border-blue-600 bg-blue-600/10"> Conversion 100%</span>
                        <span data-project-label class="py-1 px-4 border border-neutral-400 dark:border-neutral-600">Astro Build</span>
                    </div>
                </div>
                <h1 class="font-anton uppercase tracking-tighter leading-none text-[88px] md:text-[320px] flex "transition:name={`project-${entry.id}-title`}>{title}</h1>
                <p class="font-medium  uppercase text-gray-600 dark:text-gray-300 text-center text-md md:text-2xl" data-project-description>{descriptionLabel}</p> 
            </header>

            <main class="grid grid-cols-1 gap-10 px-3 md:grid-cols-2 md:mx-auto md:max-w-425  ">
                <div class="gap-y-5 flex flex-col">
                    <span class="font-medium uppercase text-sm text-blue-600 md:text-base ">
                        ( Especificaciones )
                    </span>
                    <h2 class="font-anton uppercase text-3xl md:text-5xl">
                        {titleLabel}
                    </h2>
                    <p class="font-medium text-gray-600 dark:text-gray-300 text-md md:text-lg text-balance ">
                        {descriptionSEO}
                    </p>
                    <dl class="border uppercase border-neutral-200 dark:border-neutral-700 divide-y divide-neutral-300/50 dark:divide-neutral-600/50 dots-bg">
                        <div class="flex justify-between p-3">
                            <dt class="text-gray-600 dark:text-gray-300">Cliente</dt>
                            <dd class="font-medium">{title}</dd>
                        </div>
                        <div class="flex justify-between p-3">
                            <dt class="text-gray-600 dark:text-gray-300">Plazo de entrega</dt>
                            <dd class="font-medium text-blue-600">{time}</dd>
                        </div>
                        <div class="flex justify-between p-3">
                            <dt class="text-gray-600 dark:text-gray-300">Performance</dt>
                            <dd class="font-medium">100%</dd>
                        </div>
                        <div class="flex justify-between p-3">
                            <dt class="text-gray-600 dark:text-gray-300">Stack Tecnológico</dt>
                            <dd class="font-medium">
                                <ul class="flex flex-row gap-x-2 gap-y-1">
                                    <li>TailwindCSS </li>
                                    <li>Astro.js</li>
                                    <li>GSAP</li>
                                </ul>
                            </dd>
                        </div>
                    </dl>
                    <a href={url} target="_blank" rel="noopener noreferrer" class="bg-black dark:bg-white text-white dark:text-black py-3 px-4 font-medium uppercase flex justify-center gap-x-2 md:w-1/2 hover:bg-neutral-700 dark:hover:bg-neutral-300 transition-all duration-200 group" >
                        Visitar pagina web 
                        <ArrowRight class="group-hover:translate-x-2 transition-all duration-200" />
                    </a>
                </div>
                <Image src={imgCaseStudy} alt={title} class="border border-black/20" />
            </main>
        </article>
        <div class="mx-auto max-w-380 px-3 md:px-0 py-10">
            <div class="p-5 md:p-10 border rounded-lg border-black dark:border-white/20 flex flex-col gap-y-5 md:flex-row">
                <div class="flex flex-col gap-y-5 md:w-1/2">
                    <span class="font-medium uppercase text-sm text-blue-600 md:text-base">
                        ( Contacto directo a Lsv Systems © )
                    </span>
                    <h2 class="font-anton uppercase text-3xl md:text-5xl">
                        ¿Queres una web como esta para tu negocio?
                    </h2>
                    <p class="text-gray-600 dark:text-gray-300 text-pretty text-md ">
                        Si preferis coordinar una llamada o consulta directa sin formularios, podes iniciarla en este momento.
                    </p>
                    <div class="grid grid-cols-2 md:flex gap-3">
                        <div class="flex flex-col gap-y-1 p-3 bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800">
                            <span class="uppercase text-gray-600 dark:text-gray-300 text-sm md:text-base">
                                Tiempo de entrega
                            </span>
                            <span class="font-medium">
                                1-2 Semanas
                            </span>
                        </div>
                        <div class="flex flex-col gap-y-1 p-3 bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800">
                            <span class="uppercase text-gray-600 dark:text-gray-300 text-sm md:text-base">
                                Trato
                            </span>
                            <span class="font-medium">
                                1:1 Directo
                            </span>
                        </div>
                        <div class="flex flex-col col-span-2 gap-y-1 p-3 bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800">
                            <span class="uppercase text-gray-600 dark:text-gray-300 text-sm md:text-base">
                                Rendimiento
                            </span>
                            <span class="font-medium text-blue-600">
                                99.9% Uptime
                            </span>
                        </div>
                    </div>
                    <p class="font-medium uppercase flex items-center text-sm gap-x-2">
                        <PulseDot color="green-600"/>
                        Disponible para nuevos proyectos.
                    </p>
                </div>
                <div class="flex flex-col gap-y-3 md:justify-center  md:w-1/2">
                    <a href="https://calendly.com/lsv-systems/30min" target="_blank" rel="noopener noreferrer" class="flex flex-row items-center gap-y-1 justify-between bg-blue-600 text-white group p-2 hover:bg-blue-500 transition-all duration-200">
                        <span class="flex flex-col gap-y-1">
                            <span class="font-medium uppercase">
                                Chatear por WhatsApp
                            </span>
                            <span class="font-light text-sm text-neutral-200"> 
                            Poco tiempo de espera
                            </span>    
                        </span>
                        <ArrowRight class="size-7 group-hover:translate-x-1 transition-all duration-200" />
                    </a>
                    <a href="" target="_blank" rel="noopener noreferrer" class="flex flex-row items-center p-2 gap-y-1 justify-between border border-black hover:bg-neutral-200 dark:border-white/20 dark:hover:bg-neutral-900 transition-all duration-200 group">
                        <span class="flex flex-col gap-y-1">
                            <span class="font-medium uppercase">
                                Agenda directa en Google Meet 
                            </span>
                            <span class="font-light text-balance text-sm text-neutral-600 dark:text-neutral-400">
                                Reserva tu consulta de 15 o 30 min segun tu agenda.
                            </span>
                        </span>
                        <ArrowRight class="size-7 group-hover:translate-x-1 transition-all duration-200" />
                    </a>
                </div>
            </div>
        </div>
</Layout>
