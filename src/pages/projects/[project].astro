---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
    const projects = await getCollection('projects');

    return projects.map((entry) => ({
        params: { project: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, titleSEO, description, year, tags, imgHero, url } = entry.data;
---

<Layout title={`${titleSEO}`} description={description}>
        <article class="relative overflow-hidden">
            
            <Image src={imgHero} transition:name={`project-${entry.id}-hero`} alt={title} class="blur-xs w-full h-screen" />
            
        </article>
</Layout>
