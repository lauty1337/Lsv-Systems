---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import  PulseDot  from '../../components/PulseDot.astro';
import ArrowRight from '../../assets/svgs/ArrowRight.svg'
import WhatsAppIcon from '../../assets/svgs/WhatsApp.svg'
export async function getStaticPaths() {
    const projects = await getCollection('projects');

    return projects.map((entry) => ({
        params: { project: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, titleLabel, titleSEO, descriptionSEO, descriptionLabel, year, time, tags, url, imgCaseStudy } = entry.data;
---

<Layout title={`${titleSEO}`} description={descriptionSEO} >
        <article class="py-10">

            <header class="flex flex-col justify-center items-center gap-y-3 mb-30">
                <div  class="flex flex-col items-center font-medium text-xs uppercase gap-2 md:flex-row md:text-sm z-20">
                    <span data-project-label class="py-1 px-4 bg-black dark:bg-white text-white dark:text-black flex items-center gap-x-2">
                        <PulseDot color="green-600" />
                        Estado: Activo
                    </span>
                    <div class="flex gap-x-2">
                        <span data-project-label class="py-1 px-4 text-blue-400 border border-blue-400 bg-blue-950"> Conversión 100%</span>
                        <span data-project-label class="py-1 px-4 border border-neutral-400 bg-white dark:bg-black dark:border-neutral-600">Astro Build</span>
                    </div>
                </div>
                <h1 class="font-anton uppercase tracking-tighter leading-none text-[88px] md:text-[320px] flex "transition:name={`project-${entry.id}-title`}>{title}</h1>
                <p class="font-medium  uppercase text-gray-600 dark:text-gray-300 text-center text-md md:text-2xl" data-project-description>{descriptionLabel}</p> 
            </header>

            <main class="grid grid-cols-1 gap-10 px-3 md:grid-cols-2 md:mx-auto md:max-w-425  ">
                <div class="gap-y-5 flex flex-col">
                    <span class="font-medium uppercase text-sm text-blue-600 md:text-base ">
                        ( Especificaciones )
                    </span>
                    <h2 class="font-anton uppercase text-3xl md:text-5xl tracking-tight">
                        {titleLabel}
                    </h2>
                    <p class="font-medium text-gray-600 dark:text-gray-300 text-md md:text-lg text-balance ">
                        {descriptionSEO}
                    </p>
                    <dl class="border uppercase border-neutral-200 dark:border-neutral-600 divide-y divide-neutral-300/50 dark:divide-neutral-800 dots-bg">
                        <div class="flex justify-between p-3">
                            <dt class="text-gray-600 dark:text-gray-400">Cliente</dt>
                            <dd class="font-medium">{title}</dd>
                        </div>
                        <div class="flex justify-between p-3">
                            <dt class="text-gray-600 dark:text-gray-400">Plazo de entrega</dt>
                            <dd class="font-medium text-blue-600">{time}</dd>
                        </div>
                        <div class="flex justify-between p-3">
                            <dt class="text-gray-600 dark:text-gray-400">Performance</dt>
                            <dd class="font-medium">100%</dd>
                        </div>
                        <div class="flex justify-between p-3">
                            <dt class="text-gray-600 dark:text-gray-400">Stack Tecnológico</dt>
                            <dd class="font-medium">
                                <ul class="flex flex-row gap-x-2 gap-y-1">
                                    <li>TailwindCSS </li>
                                    <li>Astro.js</li>
                                    <li>GSAP</li>
                                </ul>
                            </dd>
                        </div>
                    </dl>
                    <a href={url} target="_blank" rel="noopener noreferrer" class="bg-black dark:bg-white text-white dark:text-black py-3 px-4 font-medium uppercase flex justify-center  gap-x-2 md:w-1/2 hover:bg-neutral-700 dark:hover:bg-neutral-300 transition-all duration-200 group" >
                        Visitar página web 
                        <ArrowRight class="group-hover:translate-x-2 transition-all duration-200" />

                    </a>
                </div>
                <Image src={imgCaseStudy} alt={title} class="border border-black/20" />
            </main>
        </article>
        <section class="grid grid-cols-3 md:grid-cols-6 mx-auto max-w-250 xl:max-w-300 divide-x divide-y divide-black/80 px-3 mb-30">

            <div class="col-span-3 md:col-span-4 rounded-t-md  md:rounded-t-none md:rounded-tl-md bg-blue-600 p-5">
                <p class="uppercase text-sm text-white font-medium">
                    ( Contacto directo a LSV Systems ©)
                </p>
            </div>

            <div class="col-span-3 md:col-span-2 md:rounded-tr-md  bg-blue-600 p-5 gap-x-3 ">
                <div class="flex flex-row items-center gap-x-3 md:justify-end">
                    <PulseDot color="white"/>
                    <span class="uppercase text-sm font-medium text-white ">Disponible · Est 2026©</span>
                </div>
            </div>

            <div class="col-span-3 md:col-span-4 bg-blue-600 p-5 ">
                <h2 class="font-anton uppercase text-white text-5xl md:text-7xl tracking-tight ">
                    ¿Querés una web como esta para tu negocio?
                </h2>
            </div>

            <div class="col-span-3 md:col-span-2 bg-blue-600 p-5 flex items-end ">
                <p class="text-white font-light text-md  text-start">
                    Sin formularios, sin sorpresas. Hablas directo con quien hace el trabajo
                </p>
            </div>

            <div class="col-span-1 bg-blue-600 p-5 flex flex-col gap-y-2 md:rounded-bl-md">
                <span class="uppercase text-sm text-neutral-300">Entrega</span>
                <span class="uppercase font-anton md:text-2xl text-white">4-7 dias</span>
            </div>
            <div class="col-span-1 bg-blue-600 p-5 flex flex-col gap-y-2">
                <span class="uppercase text-sm  text-neutral-300">Desde</span>
                <span class="uppercase font-anton md:text-2xl text-white">100 Usd</span>
            </div>
            <div class="col-span-1 bg-blue-600 p-5 flex flex-col gap-y-2">
                <span class="uppercase text-sm text-neutral-300">Trato</span>
                <span class="uppercase font-anton md:text-2xl text-white">1:1</span>
            </div>
            
            <a href="" class="col-span-3 flex flex-row bg-black p-5 items-center justify-between group hover:bg-neutral-100 rounded-b-md md:rounded-b-none md:rounded-br-md  transition-colors duration-200">
                <div class="flex flex-col">
                    <span class="uppercase font-anton text-white text-2xl md:text-4xl group-hover:text-blue-600 transition-colors duration-200">Escribime por WhatsApp</span>
                    <span class="uppercase text-sm text-neutral-300 group-hover:text-blue-600 transition-colors duration-200">Respondo en ~15 min</span>
                </div>
                <ArrowRight class="text-white size-10 group-hover:text-blue-600 group-hover:translate-x-3 group-hover:-translate-y-1 transition-transform duration-200" />
            </a>

        </section>
</Layout>
