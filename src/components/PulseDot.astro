---
const { color, class: className } = Astro.props;
const colors = {
    'green-600': 'bg-green-600',
    'yellow-600': 'bg-yellow-600',
    'red-600': 'bg-red-600',
    'blue-600': 'bg-blue-600',
    'emerald-600': 'bg-emerald-600',
    'black' : 'bg-black',
    'white' : 'bg-white',
}
---

<span class:list={['relative inline-block size-2 shrink-0', className]}>
    <span class={`absolute inset-0 ${colors[color as keyof typeof colors]} rounded-full animate-ping`}></span>
    <span class={`absolute inset-0 ${colors[color as keyof typeof colors]} rounded-full`}></span>
</span>
