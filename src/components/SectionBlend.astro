---
interface Props {
    class?: string;
    position?: 'top' | 'bottom';
    height?: string;
}

const {
    class: blendClass = 'to-white dark:to-[#0d0f12]',
    position = 'bottom',
    height = 'h-20',
} = Astro.props;

const positionClass = position === 'top' ? 'top-0' : 'bottom-0';
---

<div
    aria-hidden="true"
    class:list={[
        'pointer-events-none absolute left-0 z-40 w-full bg-linear-to-b from-transparent',
        height,
        positionClass,
        blendClass,
    ]}
></div>
